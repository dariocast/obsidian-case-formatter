{
  "name": "obsidian-case-formatter",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Change the capitalization of selected text in Obsidian.",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:obsidian": "node scripts/test-obsidian.mjs",
    "lint": "eslint src manifest.json package.json --max-warnings 0",
    "check": "npm run lint && npm run test && npm run build",
    "package": "npm run check && node scripts/package.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@eslint/json": "^0.14.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "1.14.4",
    "typescript": "^5.0.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "eslint-plugin-obsidianmd": {
      "moment": "^2.31.0"
    }
  }
}
